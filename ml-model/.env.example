# ProxiSafe ML Model Configuration
PORT=5000
HOST=0.0.0.0

# CORS - Allowed origins for frontend
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Detection parameters
MIN_DISTANCE_FEET=6
ALERT_THRESHOLD=3

# Video / camera person detection (see models/video_detector.py)
# Leave DETECTOR_BACKEND unset to auto-pick YOLO when ultralytics is installed (best for crowds).
# Only set DETECTOR_BACKEND=hog if you intentionally want the weak HOG detector.
# DETECTOR_BACKEND=yolo
MIN_DISTANCE_PIXELS=80
# YOLO (after: pip install -r requirements-yolo.txt):
# YOLO_MODEL=yolov8s.pt
# YOLO_CONF=0.12
# YOLO_IMGSZ=1280
# YOLO_TILING=auto
# YOLO_TILING_MIN_EDGE=1120
# HOG tuning (hog only): HOG_SCALE=1.05  HOG_WIN_STRIDE=8
